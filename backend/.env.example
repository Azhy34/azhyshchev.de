# Express Server Port
PORT=3000

# Node Environment (development or production)
NODE_ENV=development

# CORS Whitelist Origin (comma-separated, e.g. https://azhyshchev.de,https://www.azhyshchev.de)
CORS_ORIGIN=https://azhyshchev.de

# Token required in X-Widget-Token header to authenticate widget requests
SECRET_WIDGET_TOKEN=your_secret_widget_token_here

# Google Gemini API Key (GCP Project azhyshchev / Generative Language API)
GEMINI_API_KEY=AIzaSy...

# Gemini Model to use (default: gemini-3.1-flash-lite)
# Options: gemini-3.1-flash-lite, gemini-flash-latest, gemini-3.7-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# Reasoning / Thinking Budget (tokens or level name)
# Options: off (0), low (1024), medium (2048 - default), high (4096), dynamic (-1)
GEMINI_THINKING_BUDGET=medium

# Optional — Telegram logging (each chat turn sent to bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Supabase logging + lead context lookup
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...

# Optional — disable Gemini cache in dev mode
DISABLE_CACHE=false

# Bing Webmaster Tools API Key (Settings → API Access → Generate API Key)
BING_API_KEY=your_bing_api_key_here
